{
    "name": "hoeng-bot",
    "version": "4.1.4-beta.8",
    "description": "Discord Music Bot",
    "main": "./src/index.ts",
    "type": "module",
    "scripts": {
        "start": "npm run build && ./dist/src/index.js",
        "start:server": "npm run build:server && ./dist/src/index.js",
        "build": "npm run build:dashboard && npm run build:server",
        "build:server": "tsc",
        "build:dashboard": "cd dashboard && npm run generate",
        "install:dashboard": "cd dashboard && npm install",
        "lint": "eslint . --color",
        "lint:fix": "eslint . --fix --color",
        "typecheck": "tsc --noEmit"
    },
    "author": "hoehoetvhs",
    "license": "MIT",
    "bugs": {
        "url": "https://discord.gg/HMFyw4xeeV"
    },
    "homepage": "https://discord.gg/HMFyw4xeeV",
    "overrides": {
        "undici": "^6.26.0"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^12.10.0",
        "cookie": "^1.1.1",
        "discord.js": "~14.26.4",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "i18next": "^26.3.1",
        "i18next-fs-backend": "^2.6.6",
        "lavashark": "^2.3.2",
        "undici": "^6.26.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.2",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "tsx": "^4.22.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.60.1"
    },
    "engines": {
        "node": ">=22"
    }
}
